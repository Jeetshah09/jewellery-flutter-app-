# Local default: sqlite:///./aurelia.db
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/aurelia
DATABASE_URL=sqlite:///./aurelia.db
CORS_ORIGINS=*
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_EMAIL=admin@aurelia.test
ADMIN_PASSWORD=change-this-password
PAYMENT_MODE=demo
PUBLIC_API_URL=http://127.0.0.1:8003
# Set this for live Stripe Checkout, then set PAYMENT_MODE=stripe
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:5000/#/payment-success
STRIPE_CANCEL_URL=http://localhost:5000/#/payment-cancelled
# Leave SMTP_HOST empty locally to log confirmation messages instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=orders@aurelia.test
